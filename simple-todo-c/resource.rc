#include <windows.h>

MAINICON ICON "img/todo.ico"

EDIT_TODO_DLG DIALOGEX 0, 0, 310, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Microsoft YaHei", 0, 0, 0x1
BEGIN
    LTEXT "", 100, 10, 10, 40, 10
    EDITTEXT 101, 55, 8, 245, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", 102, 10, 32, 40, 10
    EDITTEXT 103, 55, 30, 245, 35, ES_MULTILINE | WS_BORDER | ES_AUTOVSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "", IDOK, 120, 78, 50, 20
    PUSHBUTTON "", IDCANCEL, 180, 78, 50, 20
END

EDIT_ACCT_DLG DIALOGEX 0, 0, 310, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Microsoft YaHei", 0, 0, 0x1
BEGIN
    LTEXT "", 100, 10, 10, 35, 10
    EDITTEXT 101, 50, 8, 80, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", 102, 145, 10, 35, 10
    EDITTEXT 103, 185, 8, 115, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", 104, 10, 32, 35, 10
    CONTROL "", 105, "SysDateTimePick32", WS_CHILD | WS_VISIBLE | DTS_RIGHTALIGN | WS_TABSTOP, 50, 30, 100, 14
    LTEXT "", 106, 165, 32, 35, 10
    EDITTEXT 107, 205, 30, 95, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", 108, 10, 54, 35, 10
    EDITTEXT 109, 50, 52, 250, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON "", IDOK, 120, 88, 50, 20
    PUSHBUTTON "", IDCANCEL, 180, 88, 50, 20
END

REMINDER_DLG DIALOGEX 0, 0, 320, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Microsoft YaHei", 0, 0, 0x1
BEGIN
