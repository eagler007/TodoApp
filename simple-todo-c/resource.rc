    DEFPUSHBUTTON "", IDOK, 165, 6, 50, 18
    LISTBOX 102, 10, 32, 300, 180, LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
