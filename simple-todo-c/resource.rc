    LTEXT "", 104, 160, 10, 35, 10
    EDITTEXT 105, 200, 8, 70, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "", 201, 10, 34, 70, 20
    PUSHBUTTON "", 202, 90, 34, 70, 20
    PUSHBUTTON "", 203, 170, 34, 70, 20
    DEFPUSHBUTTON "", IDOK, 110, 70, 50, 20
    PUSHBUTTON "", IDCANCEL, 180, 70, 50, 20
END

