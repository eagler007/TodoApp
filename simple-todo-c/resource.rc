    END
END


EDIT_TODO_DLG DIALOGEX 0, 0, 310, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Microsoft YaHei", 0, 0, 0x1
BEGIN
    LTEXT "", 100, 10, 10, 40, 10
    EDITTEXT 101, 55, 8, 245, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", 102, 10, 32, 40, 10
